# Application
APP_ENV=development
APP_NAME=evelyn
API_HOST=0.0.0.0
API_PORT=8000

# MVP moderation mode: mock keeps local development and tests offline.
MODERATION_MODE=mock

# LLM gateway (OpenRouter when MODERATION_MODE=llm)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.4-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO
