# Application
APP_ENV=development
APP_NAME=evelyn
API_HOST=0.0.0.0
API_PORT=8000

# MVP moderation mode: mock keeps local development and tests offline.
MODERATION_MODE=mock

# LLM gateway (used only when MODERATION_MODE=llm). LLM_PROVIDER selects the
# provider; LLM_MODEL and LLM_BASE_URL are optional and default per provider.
# LLM_API_KEY is always required in llm mode.
LLM_FALLBACK_ENABLED=false

# OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-5.4-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Groq
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Explicit fallback credentials. These are used only when LLM_FALLBACK_ENABLED=true
# and the primary provider returns a retryable 429, timeout, or 5xx error.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (OpenAI-compatible endpoint; free tier is for synthetic testing only)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.4-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO
