# Application
APP_ENV=development
APP_NAME=evelyn
API_HOST=0.0.0.0
API_PORT=8000

# MVP moderation mode: mock keeps local development and tests offline.
MODERATION_MODE=mock

# LLM gateway (OpenAI-compatible Chat Completions API when MODERATION_MODE=llm)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO
