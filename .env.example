# Application
APP_ENV=development
APP_NAME=evelyn
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evelyn

# Vector search
PGVECTOR_ENABLED=true

# LLM gateway
LLM_PROVIDER=
LLM_API_KEY=
LLM_CLASSIFIER_MODEL=
LLM_REASONER_MODEL=
LLM_VALIDATOR_MODEL=

# Security
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
